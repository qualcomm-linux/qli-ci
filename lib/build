#!/bin/bash
set -eux
set -o pipefail

# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
# SPDX-License-Identifier: BSD-3-Clause-Clear

# Send a source package to Debusine for building and wait for build completion

# Run directly inside the current job container. Debusine tooling is expected to
# be available already.

# Build-dependency resolution tweaks applied here:
#   * For trixie builds, the trixie-backports suite is added to
#     extra_repositories so build-deps only available in backports can be found.
#     forky (debian/latest) is a development suite with no backports, so it is
#     skipped.
#   * Every build uses the aptitude build-dep resolver (see
#     configure_aptitude_resolver below), which copes with low-priority
#     backports far better than the default apt resolver.

# Dependencies:
#   debusine-client, python3-debusine, yq

# Inputs:
#   GITHUB_REPOSITORY_ID
#   GITHUB_RUN_ID
#   GITHUB_RUN_ATTEMPT
#   JOB_INDEX
#   DEBUSINE_HOST
#   DEBUSINE_SCOPE
#   DEBUSINE_USER (required for extra_repositories workaround)
#   DEBUSINE_TOKEN
#   DEBUSINE_PARENT_WORKSPACE (optional, defaults to qli-ci)
#   SUITE
#   EXTRA_BUILD_DEP_WORKSPACES (optional, space-separated workspace names to add as extra_repositories)
#   .dsc file in current directory

# Outputs:
#   ${GITHUB_OUTPUT:-output}: workspace, workflow_id (written before poll so they
#     survive a poll failure)
#   signing-key.asc: the build workspace's archive signing key, written to the
#     current directory after the build completes

# Resolve sibling helpers through an absolute path captured once, so that a
# later cd cannot break them.
lib_dir=$(cd "$(dirname "$0")" && pwd)

echo "::group::Build in Debusine"

# WORKAROUND: older production Debusine does not support the suite lookup syntax
# (//workspace=...) in extra_repositories. Convert each such entry to the external
# repository form. Drop this function and its single caller when the production
# instance is updated.
apply_extra_repositories_workaround() {
    local yaml_file="$1"
    [ -n "${EXTRA_BUILD_DEP_WORKSPACES:-}" ] || return 0
    local tmpfile ws indent key
    tmpfile=$(mktemp)
    while IFS= read -r line; do
        if printf '%s' "$line" | grep -qE '^ +- suite: //workspace='; then
            ws=$(printf '%s' "$line" | sed 's|.*//workspace=\([^/]*\)/.*|\1|')
            indent=$(printf '%s' "$line" | sed 's/^\( *\)- suite:.*/\1/')
            key=$(curl -fsSu "${DEBUSINE_USER}:${DEBUSINE_TOKEN}" \
                "https://deb.${DEBUSINE_HOST}/${DEBUSINE_SCOPE}/${ws}/signing-keys.asc") \
                || { rm -f "$tmpfile"; return 1; }
            printf '%s- url: https://deb.%s/%s/%s/\n' "$indent" "$DEBUSINE_HOST" "$DEBUSINE_SCOPE" "$ws"
            printf '%s  suite: %s\n' "$indent" "$SUITE"
            printf '%s  components:\n' "$indent"
            printf '%s    - main\n' "$indent"
            printf '%s    - contrib\n' "$indent"
            printf '%s    - non-free\n' "$indent"
            printf '%s    - non-free-firmware\n' "$indent"
            printf '%s  signing_key: |\n' "$indent"
            printf '%s\n' "$key" | sed "s/^/${indent}    /"
        else
            printf '%s\n' "$line"
        fi
    done < "$yaml_file" > "$tmpfile"
    mv "$tmpfile" "$yaml_file"
}

# Make the sbuild tasks for this build use the aptitude build-dep resolver.
#
# Why task configuration instead of a workflow parameter:
#   build_dep_resolver cannot be passed as debian_pipeline (or sbuild) workflow
#   task_data. Those workflow-data models forbid unknown keys (pydantic
#   extra="forbid") and simply do not define the field; the sbuild workflow only
#   ever sets it internally (aspcud for debian:experimental). The field exists
#   solely on the low-level Sbuild *worker* task. Debusine's supported mechanism
#   for overriding worker-task data is a debusine:task-configuration collection:
#   entries matching (task_type, task_name, ...) are merged into the task's
#   task_data when it becomes pending. So we set it there.
#
# Why this is safe and correctly scoped:
#   The collection is created in the ephemeral child workspace this run just
#   created and owns (the CI token is its owner). The override therefore applies
#   only to this build's sbuild task(s) and cannot affect any other build,
#   branch, or shared workspace. The workspace - and this configuration with it -
#   is discarded when the run ends. The child does not have a task-configuration
#   collection by default (it is not a singleton category), so we create one.
#
# Timing: this runs after the child workspace exists but before the
# debian_pipeline workflow starts; the override is read later, when each sbuild
# work request becomes pending during orchestration.
#
# subject/context are intentionally omitted: a bare Worker/sbuild entry matches
# every sbuild task, and this throwaway workspace only ever builds one package.
configure_aptitude_resolver() {
    local tmp
    debusine collection create default@debusine:task-configuration < /dev/null
    tmp=$(mktemp -d)
    (
        cd "$tmp"
        debusine task-config pull --workspace "$workspace" default
        cat > sbuild-aptitude.yaml <<END
task_type: Worker
task_name: sbuild
override_values:
  build_dep_resolver: aptitude
END
        debusine task-config push
    )
    rm -rf "$tmp"
}

parent_workspace=${DEBUSINE_PARENT_WORKSPACE:-qli-ci}
child_ci_suffix=gh-${GITHUB_REPOSITORY_ID:-0}-${GITHUB_RUN_ID:-0}-${GITHUB_RUN_ATTEMPT:-0}-${JOB_INDEX:-0}
workspace="${parent_workspace}-${child_ci_suffix}"

mkdir -p ~/.config/debusine/client
( umask 077; cat > ~/.config/debusine/client/config.ini <<EOF
[General]
default-server = default

[server:default]
api-url = https://${DEBUSINE_HOST}/api
scope = ${DEBUSINE_SCOPE}
token = ${DEBUSINE_TOKEN}
default-workspace = $workspace
EOF
)

workflow_start_output=$(echo "suffix: $child_ci_suffix"|debusine workflow start -w "${parent_workspace}" --yaml create-child-workspace)
echo "Workflow start output: $workflow_start_output" >&2
workflow_id=$(echo "$workflow_start_output"|yq -r .id)
"$lib_dir"/poll_workflow.py "$workflow_id"
configure_aptitude_resolver
debusine archive suite create \
    --architecture all \
    --architecture amd64 \
    --architecture arm64 \
    --component main \
    --component contrib \
    --component non-free \
    --component non-free-firmware \
    ${SUITE}
artifact_import_output=$(debusine artifact import-debian --yaml *.dsc)
echo "Artifact import output: $artifact_import_output" >&2
artifact_id=$(echo "$artifact_import_output"|yq -r .artifact_id)
_parameters_yaml=$(mktemp)
cat > "$_parameters_yaml" <<END
vendor: debian
sbuild_environment_variant: buildd
lintian_fail_on_severity: none
enable_blhc: false
enable_autopkgtest: false
enable_piuparts: false
codename: $SUITE
suite: $SUITE@debian:suite
source_artifact: ${artifact_id}@artifacts
END
# Enable backports for trixie so build-deps only available there can be found.
# Only trixie has a backports suite; forky (debian/latest) is a development
# suite without one. No signing_key is needed: deb.debian.org is signed by the
# Debian archive key already trusted via debian-archive-keyring in the chroot.
_enable_backports=
[ "$SUITE" = trixie ] && _enable_backports=1

if [ -n "${EXTRA_BUILD_DEP_WORKSPACES:-}" ] || [ -n "$_enable_backports" ]; then
    echo "extra_repositories:" >> "$_parameters_yaml"
fi
if [ -n "${EXTRA_BUILD_DEP_WORKSPACES:-}" ]; then
    for _ws in $EXTRA_BUILD_DEP_WORKSPACES; do
        echo "  - suite: //workspace=${_ws}/${SUITE}@debian:suite" >> "$_parameters_yaml"
    done
fi
if [ -n "$_enable_backports" ]; then
    cat >> "$_parameters_yaml" <<END
  - url: http://deb.debian.org/debian
    suite: ${SUITE}-backports
    components:
      - main
      - contrib
      - non-free
      - non-free-firmware
END
fi
apply_extra_repositories_workaround "$_parameters_yaml"
echo "::group::Generated debian_pipeline parameters:" >&2
cat "$_parameters_yaml" >&2
echo "::endgroup::" >&2
workflow_start_output=$(debusine workflow start --yaml --data "$_parameters_yaml" --no-template debian_pipeline)
rm "$_parameters_yaml"
echo "Workflow start output: $workflow_start_output" >&2
workflow_id=$(echo "$workflow_start_output"|yq -r .id)


echo "::notice::Debusine work request: https://${DEBUSINE_HOST}/${DEBUSINE_SCOPE}/${workspace}/work-request/${workflow_id}/ (SSO login required)."

# Emit outputs before polling so they survive a poll failure
: ${GITHUB_OUTPUT:=output}
echo "workspace=$workspace" >> "$GITHUB_OUTPUT"
echo "workflow_id=$workflow_id" >> "$GITHUB_OUTPUT"

"$lib_dir"/poll_workflow.py "$workflow_id"

# Fetch the build workspace's archive signing key now that the build has
# completed, retrying past the Debusine empty-key race (see lib/fetch-signing-key).
# Writing it to a file lets downstream steps reuse it without racing the
# archive signing-key generation themselves.
DEBUSINE_WORKSPACE="$workspace" "$lib_dir"/fetch-signing-key > signing-key.asc

echo "::endgroup::"
