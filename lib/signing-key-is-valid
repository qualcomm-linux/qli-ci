# Check whether stdin looks like a real ASCII-armored PGP public key.
#
# It must contain at least one line of base64 packet data between the armor
# markers, i.e. a line that is not blank, not the "=CRC24" checksum, and not an
# armor header ("Key: value"). This rejects the well-formed but empty armor
# block (headers and the "=CRC24" checksum only, no key packet data) that
# Debusine's signing-keys.asc briefly returns for a freshly created workspace.

# Run on the host (or in the builder container).

# Dependencies:
#   awk

# Inputs:
#   stdin: the candidate ASCII-armored key

# Outputs:
#   exit status: 0 if the key looks valid, 1 otherwise. Nothing on stdout.

exec awk '
    /-----BEGIN PGP PUBLIC KEY BLOCK-----/ { in_block = 1; next }
    /-----END PGP PUBLIC KEY BLOCK-----/   { in_block = 0; next }
    in_block {
        if ($0 == "")                        next   # blank line
        if ($0 ~ /^=/)                       next   # CRC24 checksum
        if ($0 ~ /^[A-Za-z][A-Za-z0-9-]*: /) next   # armor header
        found = 1
    }
    END { exit(found ? 0 : 1) }
'
