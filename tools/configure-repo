import json
import sys
import tempfile
from pathlib import Path
from typing import Any, Dict, List

import pkg_branch_schema
import rulesets
from gh_helpers import (
    check_gh_auth,
    create_environment,
    delete_repo_variable,
    expand_repo_name,
    get_environment,
    get_repo_branches,
    get_repo_custom_properties,
    get_repo_info,
    get_repo_variables,
    get_user_id,
    get_visible_org_secrets,
    get_visible_org_variables,
    run_gh_command,
    set_delete_branch_on_merge,
    set_repo_variable,
)

# Repository configuration data (required variables, secrets, environments,
# reviewers, etc.) lives in repo-configs.json alongside this script, so it
# can be read and audited without going through this code.
CONFIG_PATH = Path(__file__).resolve().parent / "repo-configs.json"
CONFIG: Dict[str, Any] = json.loads(CONFIG_PATH.read_text())

# Default host profile - change this constant to swap the default
DEFAULT_ENVIRONMENT = "production"




def ensure_required_reviewers(
    repo: str,
    env_name: str,
    required_reviewers: List[str],
    allow_admin_bypass: bool,
    dry_run: bool,
) -> bool:
    """
    Ensure the named environment has all required_reviewers configured and
    administrator bypass set to allow_admin_bypass. Prints status/progress
    lines matching the existing tool output style.

    Returns True if changes are needed (dry_run) or were made (not dry_run).
    """
    changes_needed = False

    env = get_environment(repo, env_name)
    if env is None:
        print(
            f"✗ Cannot configure protection rules for '{env_name}' - environment does not exist"
        )
        return True

    protection_rules = env.get("protection_rules", [])

    existing_reviewer_logins = []
    existing_reviewer_ids: Dict[str, int] = {}
    for rule in protection_rules:
        if rule.get("type") == "required_reviewers":
            for reviewer in rule.get("reviewers", []):
                login = reviewer.get("reviewer", {}).get("login")
                uid = reviewer.get("reviewer", {}).get("id")
                if login:
                    existing_reviewer_logins.append(login)
                    if uid:
                        existing_reviewer_ids[login] = uid

    can_admins_bypass = env.get("can_admins_bypass", True)

    missing_reviewers = [r for r in required_reviewers if r not in existing_reviewer_logins]
    needs_protection_update = bool(missing_reviewers) or can_admins_bypass != allow_admin_bypass

    for reviewer in required_reviewers:
        if reviewer in existing_reviewer_logins:
            print(f"✓ Required reviewer '{reviewer}' is configured for '{env_name}'")
        else:
            print(f"❌ Required reviewer '{reviewer}' is not configured for '{env_name}'")
            changes_needed = True

    if can_admins_bypass != allow_admin_bypass:
        current_state = "enabled" if can_admins_bypass else "disabled"
        desired_state = "enabled" if allow_admin_bypass else "disabled"
        print(
            f"❌ 'Allow administrators to bypass configured protection rules' is {current_state} for '{env_name}' (must be {desired_state})"
        )
        changes_needed = True
    else:
        state = "enabled" if allow_admin_bypass else "disabled"
        print(f"✓ Administrator bypass is {state} for '{env_name}'")

    if needs_protection_update and not dry_run:
        all_logins = list(existing_reviewer_logins)
        for login in missing_reviewers:
            all_logins.append(login)
        payload = {
            "reviewers": [
                {
                    "type": "User",
                    "id": existing_reviewer_ids.get(login) or get_user_id(login),
                }
                for login in all_logins
            ],
            "can_admins_bypass": allow_admin_bypass,
            "deployment_branch_policy": None,
        }
        with tempfile.NamedTemporaryFile(mode="w", suffix=".json") as f:
            json.dump(payload, f)
            f.flush()
            run_gh_command(
                [
                    "api",
                    f"repos/{repo}/environments/{env_name}",
                    "-X",
                    "PUT",
                    "--input",
                    f.name,
                ]
            )
        for login in missing_reviewers:
            print(f"✓ Set required reviewer '{login}' for '{env_name}'")
        if can_admins_bypass != allow_admin_bypass:
            state = "enabled" if allow_admin_bypass else "disabled"
            print(f"✓ Set administrator bypass to {state} for '{env_name}'")

    if needs_protection_update and dry_run:
        for login in missing_reviewers:
            print(f"  Would add required reviewer '{login}' to '{env_name}'")
        if can_admins_bypass != allow_admin_bypass:
            state = "enabled" if allow_admin_bypass else "disabled"
            print(f"  Would set administrator bypass to {state} for '{env_name}'")

    return changes_needed


def configure_repository(repo: str, debusine_host: str, dry_run: bool, force: bool = False) -> int:
    """
    Configure repository with required settings.
    Returns 0 if no changes needed, 1 if changes were made/needed.
    """
    changes_needed = False

    print(f"Configuring repository: {repo}")
    print(f"Using DEBUSINE_HOST: {debusine_host}")
    print()

    variables = get_repo_variables(repo)

    # Prerequisite checks
    print("Checking repository prerequisites...")
    prereq_failures = False

    required_visibility = CONFIG["prerequisites"]["visibility"]
    repo_info = get_repo_info(repo)
    actual_visibility = repo_info.get("visibility")

    test_pkg_exception = CONFIG["prerequisites"].get("test_pkg_exception")
    is_test_pkg = bool(
        test_pkg_exception and variables.get(test_pkg_exception["variable"]) == "true"
    )
    allowed_visibilities = {required_visibility}
    if is_test_pkg:
        allowed_visibilities.add(test_pkg_exception["allowed_visibility"])

    if actual_visibility not in allowed_visibilities:
        print(f"❌ Repository is not {required_visibility} (visibility: {actual_visibility or 'unknown'})")
        prereq_failures = True
    elif actual_visibility == required_visibility:
        print(f"✓ Repository is {required_visibility}")
    else:
        print(
            f"✓ Repository is {actual_visibility} "
            f"({test_pkg_exception['variable']}=true allows this)"
        )

    props = get_repo_custom_properties(repo)
    for prop_name, expected_value in CONFIG["prerequisites"]["custom_properties"].items():
        if props.get(prop_name) != expected_value:
            current = props.get(prop_name, "unset")
            print(f"❌ Custom property '{prop_name}' is not set to '{expected_value}' (current: {current})")
            prereq_failures = True
        else:
            print(f"✓ Custom property '{prop_name}' is set to '{expected_value}'")

    if prereq_failures:
        if dry_run:
            print("Warning: Prerequisite checks failed. "
                  "Running without --check will fail unless --force is provided.")
        elif not force:
            print()
            print("Error: Prerequisite checks failed. Use --force to override.")
            return 1
        else:
            print("Warning: Prerequisite checks failed (proceeding due to --force).")
    print()

    # 0. Check default branch
    required_default_branch = CONFIG["default_branch"]
    default_branch = repo_info["default_branch"]
    if default_branch != required_default_branch:
        print(
            f"❌ Default branch is '{default_branch}', must be '{required_default_branch}'"
        )
        return 1
    else:
        print(f"✓ Default branch is '{required_default_branch}'")
    print()

    # 1. Ensure all managed environments exist
    print("Checking environments...")
    for env_name in CONFIG["environments"]:
        env = get_environment(repo, env_name)
        if env is None:
            print(f"❌ Environment '{env_name}' does not exist")
            changes_needed = True
            if not dry_run:
                create_environment(repo, env_name, dry_run)
                print(f"✓ Created environment '{env_name}'")
        else:
            print(f"✓ Environment '{env_name}' exists")

    print()

    # 2. Check and set required variables
    print("Checking repository variables...")

    required_vars = {
        "DEBUSINE_HOST": debusine_host,
        **CONFIG["variables"]["required"],
    }

    for var_name, expected_value in required_vars.items():
        current_value = variables.get(var_name)
        if current_value != expected_value:
            print(
                f"❌ Variable {var_name} should be '{expected_value}' (currently: {current_value or 'unset'})"
            )
            changes_needed = True
            if not dry_run:
                set_repo_variable(repo, var_name, expected_value, dry_run)
                print(f"✓ Set {var_name}={expected_value}")
        else:
            print(f"✓ Variable {var_name} is correctly set")

    # 3. Ensure prohibited variables are not set
    for prohibited_var in CONFIG["variables"]["prohibited"]:
        if prohibited_var in variables:
            print(
                f"❌ Variable {prohibited_var} should not be set (currently: {variables[prohibited_var]})"
            )
            changes_needed = True
            if not dry_run:
                delete_repo_variable(repo, prohibited_var, dry_run)
                print(f"✓ Deleted {prohibited_var}")
        else:
            print(f"✓ Variable {prohibited_var} is not set")

    print()

    # 4. Check organization secret visibility
    print("Checking organization secret visibility...")
    visible_org_secrets = get_visible_org_secrets(repo)
    for secret_name in CONFIG["organization_secrets"]:
        if secret_name in visible_org_secrets:
            print(f"✓ Organization secret '{secret_name}' is visible to this repository")
        else:
            print(
                f"❌ Organization secret '{secret_name}' is not visible to this "
                "repository (an org admin must grant access in organization "
                "secret settings)"
            )
            changes_needed = True

    print()

    # 5. Check organization variables
    print("Checking organization variables...")
    visible_org_variables = get_visible_org_variables(repo)
    for var_name, expected_value in CONFIG["organization_variables"].items():
        if var_name not in visible_org_variables:
            print(
                f"❌ Organization variable '{var_name}' is not visible to this "
                "repository (an org admin must grant access in organization "
                "variable settings)"
            )
            changes_needed = True
        elif visible_org_variables[var_name] != expected_value:
            print(
                f"❌ Organization variable '{var_name}' should be '{expected_value}' "
                f"(currently: {visible_org_variables[var_name]}; an org admin must update it)"
            )
            changes_needed = True
        else:
            print(f"✓ Organization variable '{var_name}' is correctly set")

    for var_name in CONFIG["variables"].get("required_present", []):
        if variables.get(var_name):
            print(f"✓ Variable '{var_name}' is set")
        else:
            print(
                f"❌ Variable '{var_name}' is not set (no fixed value to apply; "
                "must be set manually)"
            )
            changes_needed = True

    print()

    # 6. Configure environment protection rules
    print("Checking environment protection rules...")

    # ensure_required_reviewers() reports a missing environment gracefully
    # (as a needed change) rather than aborting, so all reviewer-enforced
    # environments are always checked/reported, even in --check mode when
    # some of them don't exist yet.
    for index, (env_name, env_config) in enumerate(CONFIG["environments"].items()):
        protection = env_config["protection"]
        if index > 0:
            print()

        if protection["type"] == "required_reviewers":
            if ensure_required_reviewers(
                repo,
                env_name,
                protection["reviewers"],
                protection["allow_admin_bypass"],
                dry_run,
            ):
                changes_needed = True
        elif protection["type"] == "none":
            env = get_environment(repo, env_name)
            if env is not None:
                rules = env.get("protection_rules", [])
                if rules:
                    rule_types = [r.get("type", "unknown") for r in rules]
                    print(f"❌ Environment '{env_name}' has protection rules: {', '.join(rule_types)}")
                    changes_needed = True
                    if not dry_run:
                        payload = {"reviewers": [], "deployment_branch_policy": None}
                        with tempfile.NamedTemporaryFile(mode="w", suffix=".json") as f:
                            json.dump(payload, f)
                            f.flush()
                            run_gh_command([
                                "api", f"repos/{repo}/environments/{env_name}",
                                "-X", "PUT", "--input", f.name,
                            ])
                        print(f"✓ Cleared protection rules from '{env_name}' environment")
                    else:
                        print(f"  Would clear protection rules from '{env_name}' environment")
                else:
                    print(f"✓ Environment '{env_name}' has no protection rules")

    print()

    # 7. Check packaging branch naming
    print("Checking packaging branch naming...")
    packaging_branch_schema = CONFIG["packaging_branch_schema"]
    families = packaging_branch_schema["families"]
    pattern = pkg_branch_schema.build_packaging_branch_pattern(packaging_branch_schema)
    packaging_branches_found = False
    for branch_name in get_repo_branches(repo):
        if not pkg_branch_schema.is_packaging_branch_attempt(branch_name, families):
            continue
        packaging_branches_found = True
        if pattern.match(branch_name):
            print(f"✓ Branch '{branch_name}' has a valid packaging branch name")
        else:
            print(f"❌ Branch '{branch_name}' does not have a valid packaging branch name")
            changes_needed = True
    if not packaging_branches_found:
        print("✓ No packaging branches found")

    print()

    # 8. Check rulesets
    print("Checking rulesets...")
    if rulesets.check_rulesets(repo, CONFIG, dry_run):
        changes_needed = True

    print()

    # 9. Check delete-branch-on-merge setting
    print("Checking delete-branch-on-merge setting...")
    required_delete_branch_on_merge = CONFIG["delete_branch_on_merge"]
    current_delete_branch_on_merge = repo_info.get("delete_branch_on_merge", False)
    if current_delete_branch_on_merge != required_delete_branch_on_merge:
        print(
            f"❌ 'Automatically delete head branches' is "
            f"{'enabled' if current_delete_branch_on_merge else 'disabled'}, must be "
            f"{'enabled' if required_delete_branch_on_merge else 'disabled'}"
        )
        changes_needed = True
        if not dry_run:
            set_delete_branch_on_merge(repo, required_delete_branch_on_merge, dry_run)
            print(
                f"✓ Set 'Automatically delete head branches' to "
                f"{'enabled' if required_delete_branch_on_merge else 'disabled'}"
            )
    else:
        state = "enabled" if required_delete_branch_on_merge else "disabled"
        print(f"✓ 'Automatically delete head branches' is {state}")

    print()

    if dry_run:
        if changes_needed:
            print("Summary: Changes are needed (run without --check to apply)")
            return 1
        else:
            print("Summary: Repository is correctly configured")
            return 0
    else:
        if changes_needed:
            print("Summary: Changes have been applied")
            return 0
        else:
            print("Summary: No changes were needed")
            return 0


def main():
    """Main entry point."""
    args = sys.argv[1:]

    if not args or args[0] in ["-h", "--help"]:
        print(__doc__)
        return 0

    dry_run = False
    force = False
    repo_name = None
    environment = DEFAULT_ENVIRONMENT

    for arg in args:
        if arg == "--check":
            dry_run = True
        elif arg == "--force":
            force = True
        elif arg == "--production":
            environment = "production"
        elif arg == "--stage":
            environment = "stage"
        elif not arg.startswith("-"):
            repo_name = arg

    if not repo_name:
        print("Error: Repository name is required", file=sys.stderr)
        print(__doc__)
        return 1

    # Get the debusine host for the selected environment
    debusine_host = CONFIG["host_profiles"][environment]["DEBUSINE_HOST"]

    # Check gh authentication
    if not check_gh_auth():
        print(
            "Error: gh is not authenticated. Run 'gh auth login' first.",
            file=sys.stderr,
        )
        return 1

    # Expand repo name
    full_repo = expand_repo_name(repo_name)

    # Configure repository
    return configure_repository(full_repo, debusine_host, dry_run, force)


if __name__ == "__main__":
    sys.exit(main())
