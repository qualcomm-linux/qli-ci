{
  "default_branch": "qli-ci",
  "delete_branch_on_merge": true,
  "prerequisites": {
    "visibility": "public",
    "custom_properties": {
      "is-pkg-repo": "true"
    }
  },
  "host_profiles": {
    "production": {
      "DEBUSINE_HOST": "debusine.qualcomm.com"
    },
    "stage": {
      "DEBUSINE_HOST": "stage.debusine.qualcomm.com"
    }
  },
  "variables": {
    "required": {
      "DEBUSINE_SCOPE": "qualcomm"
    },
    "required_present": [
      "UPSTREAM_REPO_GITHUB_NAME"
    ],
    "prohibited": [
      "DEBUSINE_PARENT_WORKSPACE"
    ]
  },
  "organization_secrets": [
    "DEB_PKG_BOT_CI_QSC_TOKEN",
    "DEB_PKG_BOT_CI_TOKEN"
  ],
  "organization_variables": {
    "DEB_PKG_BOT_CI_EMAIL": "githubservice@qti.qualcomm.com",
    "DEB_PKG_BOT_CI_NAME": "GitHub Service Bot",
    "DEB_PKG_BOT_CI_USERNAME": "qcom-service-bot"
  },
  "packaging_branch_schema": {
    "families": {
      "debian": [
        "trixie",
        "latest",
        "unstable",
        "sid"
      ],
      "ubuntu": [
        "resolute"
      ]
    },
    "shapes": [
      "family/suite",
      "*/family/suite"
    ]
  },
  "rulesets": {
    "pkg branches": {
      "target_branches": "packaging_branch_schema",
      "enforcement": "active",
      "bypass_actors": [
        {
          "type": "user",
          "login": "qcom-service-bot",
          "bypass_mode": "always"
        }
      ],
      "rules": {
        "non_fast_forward": {},
        "pull_request": {
          "required_approving_review_count": 0
        },
        "required_status_checks": {
          "strict_required_status_checks_policy": true,
          "do_not_enforce_on_create": true,
          "required_status_checks": [
            {
              "context": "PR Build / Test",
              "integration_id": 15368
            }
          ]
        }
      }
    },
    "default branch": {
      "target_branches": "default_branch",
      "enforcement": "active",
      "bypass_actors": [
        {
          "type": "user",
          "login": "qcom-service-bot",
          "bypass_mode": "always"
        }
      ],
      "rules": {
        "pull_request": {
          "required_approving_review_count": 0
        }
      }
    }
  },
  "environments": {
    "Production": {
      "protection": {
        "type": "required_reviewers",
        "reviewers": [
          "basak-qcom",
          "gagath",
          "lool",
          "obbardc",
          "slyon"
        ],
        "allow_admin_bypass": false
      }
    },
    "Ubuntu Production": {
      "protection": {
        "type": "required_reviewers",
        "reviewers": [
          "abickett",
          "bjordiscollaku",
          "keerthi-go"
        ],
        "allow_admin_bypass": false
      }
    },
    "Staging": {
      "protection": {
        "type": "none"
      }
    }
  }
}
