import json
import subprocess
import sys
import tempfile
from typing import Dict, List, Optional

from repo_common import (
    active_repo_refusal_message,
    check_gh_auth,
    expand_repo_name,
    get_repo_custom_properties,
    is_pkg_repo_approved,
    is_repo_active,
    run_gh_command,
    ActiveRepoListError,
)

# Default environment - change this constant to swap the default
DEFAULT_ENVIRONMENT = "production"

# Required reviewers for the Production environment (keep sorted
# alphabetically)
REQUIRED_REVIEWERS = ["basak-qcom", "gagath", "lool", "obbardc", "slyon"]

# Required reviewers for the Ubuntu Production environment (keep sorted
# alphabetically)
REQUIRED_REVIEWERS_UBUNTU_PRODUCTION = ["abickett", "bjordiscollaku", "keerthi-go"]

# Required reviewers for the Axiom environment, which gates the AXIOM check
# job (keep sorted alphabetically)
REQUIRED_REVIEWERS_AXIOM = ["qcom-service-bot"]

# Environments that require a required-reviewers protection rule, mapped to
# the reviewers each one must have. This is the single source of truth for
# which environments get reviewer enforcement; MANAGED_ENVIRONMENTS below
# (existence-only) is derived from it plus Staging, which has no protection
# rules.
REVIEWER_ENFORCED_ENVIRONMENTS = {
    "Production": REQUIRED_REVIEWERS,
    "Ubuntu Production": REQUIRED_REVIEWERS_UBUNTU_PRODUCTION,
    "Axiom": REQUIRED_REVIEWERS_AXIOM,
}

# Environments that must simply exist (existence is checked/created for all
# of these; required-reviewer protection rules are enforced separately below
# for the subset that need them)
MANAGED_ENVIRONMENTS = list(REVIEWER_ENFORCED_ENVIRONMENTS) + ["Staging"]

# Environment to host mapping
ENVIRONMENT_HOSTS = {
    "production": "debusine.qualcomm.com",
    "stage": "stage.debusine.qualcomm.com",
}

# Organization-level secrets that must be visible to the repository. This
# tool grants access automatically if the caller's own gh auth carries the
# admin:org scope; otherwise granting fails and is reported, since that
# requires org admin access this tool may not have.
REQUIRED_ORG_SECRETS = ["DEB_PKG_BOT_CI_QSC_TOKEN", "DEB_PKG_BOT_CI_TOKEN"]


def get_repo_info(repo: str) -> Dict:
    """Get repository metadata (default_branch, visibility, etc.)."""
    stdout = run_gh_command(["api", f"repos/{repo}"])
    return json.loads(stdout)


def get_environment(repo: str, env_name: str) -> Optional[Dict]:
    """Get environment details if it exists."""
    try:
        stdout = run_gh_command(
            ["api", f"repos/{repo}/environments/{env_name}"]
        )
        return json.loads(stdout)
    except subprocess.CalledProcessError:
        return None


def create_environment(repo: str, env_name: str, dry_run: bool) -> None:
    """Create an environment."""
    if dry_run:
        print(f"  Would create environment: {env_name}")
        return

    run_gh_command(
        ["api", f"repos/{repo}/environments/{env_name}", "-X", "PUT"]
    )


def get_repo_variables(repo: str) -> Dict[str, str]:
    """Get all repository-level variables."""
    stdout = run_gh_command(["api", f"repos/{repo}/actions/variables"])
    data = json.loads(stdout)
    return {var["name"]: var["value"] for var in data.get("variables", [])}


def get_visible_org_secrets(repo: str) -> List[str]:
    """Get names of organization-level secrets visible to this repository."""
    stdout = run_gh_command(
        [
            "api",
            "--paginate",
            f"repos/{repo}/actions/organization-secrets",
            "-q",
            ".secrets[].name",
        ]
    )
    # Splitting on whitespace relies on secret names never containing spaces.
    # GitHub enforces this itself (secret names may only contain alphanumeric
    # characters and underscores), but this parsing is fragile if that were
    # ever not the case.
    return stdout.split()


def grant_org_secret_access(repo: str, secret_name: str, repo_id: int) -> None:
    """
    Grant this repository access to a 'selected'-visibility organization
    secret. Only adds this one repository to the secret's existing access
    list - never replaces it, and never touches the secret's value. Requires
    the caller's own gh auth to carry the admin:org scope.
    """
    org = repo.split("/")[0]
    run_gh_command(
        ["api", f"orgs/{org}/actions/secrets/{secret_name}/repositories/{repo_id}", "-X", "PUT"]
    )


def set_repo_variable(repo: str, name: str, value: str, dry_run: bool) -> None:
    """Set a repository-level variable."""
    if dry_run:
        print(f"  Would set variable {name}={value}")
        return

    # Try to update first
    try:
        run_gh_command(
            [
                "api",
                f"repos/{repo}/actions/variables/{name}",
                "-X",
                "PATCH",
                "-f",
                f"value={value}",
            ]
        )
        return
    except subprocess.CalledProcessError:
        pass

    # If update failed, try to create
    run_gh_command(
        [
            "api",
            f"repos/{repo}/actions/variables",
            "-X",
            "POST",
            "-f",
            f"name={name}",
            "-f",
            f"value={value}",
        ]
    )


def delete_repo_variable(repo: str, name: str, dry_run: bool) -> None:
    """Delete a repository-level variable."""
    if dry_run:
        print(f"  Would delete variable {name}")
        return

    run_gh_command(
        ["api", f"repos/{repo}/actions/variables/{name}", "-X", "DELETE"]
    )


def get_user_id(username: str) -> int:
    """Get a GitHub user's numeric ID."""
    stdout = run_gh_command(["api", f"users/{username}"])
    data = json.loads(stdout)
    return data["id"]


def ensure_required_reviewers(
    repo: str, env_name: str, required_reviewers: List[str], dry_run: bool
) -> bool:
    """
    Ensure the named environment has all required_reviewers configured and
    administrator bypass disabled. Prints status/progress lines matching the
    existing tool output style.

    Returns True if changes are needed (dry_run) or were made (not dry_run).
    """
    changes_needed = False

    env = get_environment(repo, env_name)
    if env is None:
        print(
            f"✗ Cannot configure protection rules for '{env_name}' - environment does not exist"
        )
        return True

    protection_rules = env.get("protection_rules", [])

    existing_reviewer_logins = []
    existing_reviewer_ids: Dict[str, int] = {}
    for rule in protection_rules:
        if rule.get("type") == "required_reviewers":
            for reviewer in rule.get("reviewers", []):
                login = reviewer.get("reviewer", {}).get("login")
                uid = reviewer.get("reviewer", {}).get("id")
                if login:
                    existing_reviewer_logins.append(login)
                    if uid:
                        existing_reviewer_ids[login] = uid

    can_admins_bypass = env.get("can_admins_bypass", True)

    missing_reviewers = [r for r in required_reviewers if r not in existing_reviewer_logins]
    needs_protection_update = bool(missing_reviewers) or can_admins_bypass

    for reviewer in required_reviewers:
        if reviewer in existing_reviewer_logins:
            print(f"✓ Required reviewer '{reviewer}' is configured for '{env_name}'")
        else:
            print(f"❌ Required reviewer '{reviewer}' is not configured for '{env_name}'")
            changes_needed = True

    if can_admins_bypass:
        print(
            f"❌ 'Allow administrators to bypass configured protection rules' is enabled for '{env_name}' (must be disabled)"
        )
        changes_needed = True
    else:
        print(f"✓ Administrator bypass is disabled for '{env_name}'")

    if needs_protection_update and not dry_run:
        all_logins = list(existing_reviewer_logins)
        for login in missing_reviewers:
            all_logins.append(login)
        payload = {
            "reviewers": [
                {
                    "type": "User",
                    "id": existing_reviewer_ids.get(login) or get_user_id(login),
                }
                for login in all_logins
            ],
            "can_admins_bypass": False,
            "deployment_branch_policy": None,
        }
        with tempfile.NamedTemporaryFile(mode="w", suffix=".json") as f:
            json.dump(payload, f)
            f.flush()
            run_gh_command(
                [
                    "api",
                    f"repos/{repo}/environments/{env_name}",
                    "-X",
                    "PUT",
                    "--input",
                    f.name,
                ]
            )
        for login in missing_reviewers:
            print(f"✓ Set required reviewer '{login}' for '{env_name}'")
        if can_admins_bypass:
            print(f"✓ Disabled administrator bypass for '{env_name}'")

    if needs_protection_update and dry_run:
        for login in missing_reviewers:
            print(f"  Would add required reviewer '{login}' to '{env_name}'")
        if can_admins_bypass:
            print(f"  Would disable administrator bypass for '{env_name}'")

    return changes_needed


def configure_repository(repo: str, debusine_host: str, dry_run: bool, force: bool = False) -> int:
    """
    Configure repository with required settings.
    Returns 0 if no changes needed, 1 if changes were made/needed.
    """
    changes_needed = False

    print(f"Configuring repository: {repo}")
    print(f"Using DEBUSINE_HOST: {debusine_host}")
    print()

    # Prerequisite checks
    print("Checking repository prerequisites...")
    prereq_failures = False

    repo_info = get_repo_info(repo)
    if repo_info.get("visibility") != "public":
        print(f"❌ Repository is not public (visibility: {repo_info.get('visibility', 'unknown')})")
        prereq_failures = True
    else:
        print("✓ Repository is public")

    # COMPLIANCE GATE: QLI CI may only be enabled once the 'is-pkg-repo'
    # custom property is set to 'true', recording that compliance approval has
    # taken place. is_pkg_repo_approved() is the single source of truth for
    # this check (shared across all three tools). The gate is deliberate and
    # MUST NOT be bypassable (not by --force, nor by any other means); it is
    # checked separately from, and ahead of, the --force-able prerequisites
    # above. See SPECIFICATION.md ("Compliance Gate: is-pkg-repo"). Do not
    # relax this without a corresponding specification change and compliance
    # sign-off.
    if not is_pkg_repo_approved(repo):
        current = get_repo_custom_properties(repo).get("is-pkg-repo", "unset")
        print(f"❌ Custom property 'is-pkg-repo' is not set to 'true' (current: {current})")
        print()
        print(
            "Error: the 'is-pkg-repo' compliance gate is not satisfied. This "
            "gate ensures compliance approval has taken place before QLI CI is "
            "enabled on a repository and cannot be bypassed (--force does not "
            "apply to it)."
        )
        return 1
    else:
        print("✓ Custom property 'is-pkg-repo' is set to 'true'")

    if prereq_failures:
        if dry_run:
            print("Warning: Prerequisite checks failed. "
                  "Running without --check will fail unless --force is provided.")
        elif not force:
            print()
            print("Error: Prerequisite checks failed. Use --force to override.")
            return 1
        else:
            print("Warning: Prerequisite checks failed (proceeding due to --force).")
    print()

    # 0. Check default branch
    default_branch = repo_info["default_branch"]
    if default_branch != "qli-ci":
        print(
            f"❌ Default branch is '{default_branch}', must be 'qli-ci'"
        )
        return 1
    else:
        print("✓ Default branch is 'qli-ci'")
    print()

    # 1. Ensure all managed environments exist
    print("Checking environments...")
    for env_name in MANAGED_ENVIRONMENTS:
        env = get_environment(repo, env_name)
        if env is None:
            print(f"❌ Environment '{env_name}' does not exist")
            changes_needed = True
            if not dry_run:
                create_environment(repo, env_name, dry_run)
                print(f"✓ Created environment '{env_name}'")
        else:
            print(f"✓ Environment '{env_name}' exists")

    print()

    # 2. Check and set required variables
    print("Checking repository variables...")
    variables = get_repo_variables(repo)

    required_vars = {
        "DEBUSINE_HOST": debusine_host,
        "DEBUSINE_SCOPE": "qualcomm",
        "AXIOM_ENABLE": "false",
        "AXIOM_ENABLE_PR": "false",
        "AXIOM_ENABLE_RELEASE": "false",
        "AXIOM_ENABLE_DAILY": "false",
    }

    for var_name, expected_value in required_vars.items():
        current_value = variables.get(var_name)
        if current_value != expected_value:
            print(
                f"❌ Variable {var_name} should be '{expected_value}' (currently: {current_value or 'unset'})"
            )
            changes_needed = True
            if not dry_run:
                set_repo_variable(repo, var_name, expected_value, dry_run)
                print(f"✓ Set {var_name}={expected_value}")
        else:
            print(f"✓ Variable {var_name} is correctly set")

    # 3. Ensure prohibited variable is not set
    prohibited_var = "DEBUSINE_PARENT_WORKSPACE"
    if prohibited_var in variables:
        print(
            f"❌ Variable {prohibited_var} should not be set (currently: {variables[prohibited_var]})"
        )
        changes_needed = True
        if not dry_run:
            delete_repo_variable(repo, prohibited_var, dry_run)
            print(f"✓ Deleted {prohibited_var}")
    else:
        print(f"✓ Variable {prohibited_var} is not set")

    print()

    # 4. Configure environment protection rules
    print("Checking environment protection rules...")

    # ensure_required_reviewers() reports a missing environment gracefully
    # (as a needed change) rather than aborting, so all reviewer-enforced
    # environments are always checked/reported, even in --check mode when
    # some of them don't exist yet.
    for index, (env_name, reviewers) in enumerate(REVIEWER_ENFORCED_ENVIRONMENTS.items()):
        if index > 0:
            print()
        if ensure_required_reviewers(repo, env_name, reviewers, dry_run):
            changes_needed = True

    # Check Staging has no protection rules
    staging_env = get_environment(repo, "Staging")
    if staging_env is not None:
        staging_rules = staging_env.get("protection_rules", [])
        if staging_rules:
            rule_types = [r.get("type", "unknown") for r in staging_rules]
            print(f"❌ Environment 'Staging' has protection rules: {', '.join(rule_types)}")
            changes_needed = True
            if not dry_run:
                payload = {"reviewers": [], "deployment_branch_policy": None}
                with tempfile.NamedTemporaryFile(mode="w", suffix=".json") as f:
                    json.dump(payload, f)
                    f.flush()
                    run_gh_command([
                        "api", f"repos/{repo}/environments/Staging",
                        "-X", "PUT", "--input", f.name,
                    ])
                print("✓ Cleared protection rules from 'Staging' environment")
            else:
                print("  Would clear protection rules from 'Staging' environment")
        else:
            print("✓ Environment 'Staging' has no protection rules")

    print()

    # 5. Check organization secret visibility
    print("Checking organization secret visibility...")
    visible_org_secrets = get_visible_org_secrets(repo)
    for secret_name in REQUIRED_ORG_SECRETS:
        if secret_name in visible_org_secrets:
            print(f"✓ Organization secret '{secret_name}' is visible to this repository")
            continue

        print(f"❌ Organization secret '{secret_name}' is not visible to this repository")
        changes_needed = True

        if dry_run:
            print(f"  Would grant repository access to {secret_name}")
            continue

        try:
            grant_org_secret_access(repo, secret_name, repo_info["id"])
            print(f"✓ Granted repository access to {secret_name}")
        except subprocess.CalledProcessError:
            print(
                f"❌ Could not grant access to {secret_name} "
                "(requires org admin access with the admin:org scope) - "
                "an org admin must grant it manually"
            )

    print()

    if dry_run:
        if changes_needed:
            print("Summary: Changes are needed (run without --check to apply)")
            return 1
        else:
            print("Summary: Repository is correctly configured")
            return 0
    else:
        if changes_needed:
            print("Summary: Changes have been applied")
            return 0
        else:
            print("Summary: No changes were needed")
            return 0


def main():
    """Main entry point."""
    args = sys.argv[1:]

    if not args or args[0] in ["-h", "--help"]:
        print(__doc__)
        return 0

    dry_run = False
    force = False
    repo_name = None
    environment = DEFAULT_ENVIRONMENT

    for arg in args:
        if arg == "--check":
            dry_run = True
        elif arg == "--force":
            force = True
        elif arg == "--production":
            environment = "production"
        elif arg == "--stage":
            environment = "stage"
        elif not arg.startswith("-"):
            repo_name = arg

    if not repo_name:
        print("Error: Repository name is required", file=sys.stderr)
        print(__doc__)
        return 1

    # Get the debusine host for the selected environment
    debusine_host = ENVIRONMENT_HOSTS[environment]

    # Check gh authentication
    if not check_gh_auth():
        print(
            "Error: gh is not authenticated. Run 'gh auth login' first.",
            file=sys.stderr,
        )
        return 1

    # Expand repo name
    full_repo = expand_repo_name(repo_name)

    # Active-repo targeting guard: refuse to act on repositories that are not
    # on the live active-repo list, unless --force is given. Checked up front,
    # before any repository state is read or changed.
    if not force:
        try:
            if not is_repo_active(repo_name):
                print(f"Error: {active_repo_refusal_message(repo_name)}", file=sys.stderr)
                return 1
        except ActiveRepoListError as e:
            print(f"Error: {e}", file=sys.stderr)
            return 1

    # Configure repository
    return configure_repository(full_repo, debusine_host, dry_run, force)


if __name__ == "__main__":
    sys.exit(main())
