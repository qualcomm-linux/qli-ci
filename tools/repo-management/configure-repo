#!/usr/bin/env python3
"""
Configure a GitHub repository with required settings for Debusine workflows.

Usage:
    configure-repo [--check] [--force] [--production | --stage] <repo-name>

Arguments:
    repo-name    Repository name with pkg- prefix (e.g., 'pkg-fastrpc' expands to 'qualcomm-linux/pkg-fastrpc')

Options:
    --check         Only report what needs changing without making changes
    --force         Proceed even if the public-visibility prerequisite check
                    fails, or if the repository is not on the active-repo list.
                    The 'is-pkg-repo' compliance gate is NOT bypassable
                    by --force (or anything else); see SPECIFICATION.md.
    --production    Set DEBUSINE_HOST to debusine.qualcomm.com (default)
    --stage         Set DEBUSINE_HOST to stage.debusine.qualcomm.com
"""

