class CLIError(Exception):
    def __init__(self, message: str, exit_code: int = 2):
        super().__init__(message)
        self.exit_code = exit_code


class PushCallbacks(pygit2.RemoteCallbacks):
    """RemoteCallbacks that captures per-ref push rejections.

    pygit2's Remote.push() only raises for transport-level failures. A server
    rejecting an individual ref (e.g. branch protection or a non-fast-forward
    update) is reported *only* through push_update_reference, so without this a
    rejected push silently looks like a success. We record the rejection reason
    per ref so the caller can turn it into a hard error.
    """

    def __init__(self, token: str):
        super().__init__(credentials=pygit2.UserPass("x-oauth-basic", token))
        self.rejections: Dict[str, str] = {}

    def push_update_reference(self, refname: str, message: Optional[str]) -> None:
        # message is None when the ref updated successfully; a non-None string
        # is the server's reason for rejecting this ref.
        if message is not None:
            self.rejections[refname] = message


def push_or_raise(
    remote: pygit2.Remote,
    refspec: str,
    callbacks: PushCallbacks,
) -> None:
    """Push a single refspec and raise CLIError if the server rejected any ref."""
    callbacks.rejections.clear()
    remote.push([refspec], callbacks=callbacks)
    if callbacks.rejections:
        detail = "; ".join(
            f"{ref}: {msg}" for ref, msg in callbacks.rejections.items()
        )
        raise CLIError(f"remote rejected push ({refspec}): {detail}")


def get_token() -> str:
    """Obtain the GitHub token via gh CLI."""
    try:
        result = subprocess.run(
            ["gh", "auth", "token"], capture_output=True, text=True, check=True
        )
        token = result.stdout.strip()
        if not token:
            raise CLIError("gh returned an empty token. Run 'gh auth login' first.")
        return token
    except subprocess.CalledProcessError:
        raise CLIError("gh is not authenticated. Run 'gh auth login' first.")
    except FileNotFoundError:
        raise CLIError("gh CLI not found. Install it and run 'gh auth login'.")


def require_pkg_repo_compliance_gate(repo: str) -> None:
    """
    COMPLIANCE GATE: refuse to proceed unless the 'is-pkg-repo' custom property
    is set to 'true'. is_pkg_repo_approved() is the single source of truth for
    this check (shared across all three tools); this wrapper adapts it to this
    tool's CLIError-based error handling. The gate is deliberate and MUST NOT
    be bypassable by any means (there is deliberately no --force or
    equivalent), and it is enforced in all modes, including --check. See
    SPECIFICATION.md ("Compliance Gate: is-pkg-repo"). Do not relax this
    without a corresponding specification change and compliance sign-off.

    Raises CLIError if the gate is not satisfied.
    """
    try:
        approved = is_pkg_repo_approved(repo)
    except FileNotFoundError:
        raise CLIError("gh CLI not found. Install it and run 'gh auth login'.")
    except subprocess.CalledProcessError as e:
        raise CLIError(f"failed to read custom properties for {repo}: {e.stderr.strip()}")
    if not approved:
        current = get_repo_custom_properties(repo).get("is-pkg-repo", "unset")
        raise CLIError(
            f"custom property 'is-pkg-repo' is not set to 'true' (current: {current}). "
            "This compliance gate ensures compliance approval has taken place before "
            "QLI CI is enabled on a repository and cannot be bypassed."
        )


def is_ubuntu_packaging_branch(branch: str) -> bool:
    """Return True if branch is, or ends in, qcom/ubuntu/<codename>.

    The suffix match lets an explicitly given test branch such as
    dev/foo/qcom/ubuntu/resolute receive the Ubuntu file set. Auto-discovery
    of managed branches uses UBUNTU_PACKAGING_BRANCH_PATTERN.fullmatch()
    instead.
    """
    suffix = rf"(?:^|/){UBUNTU_PACKAGING_BRANCH_PATTERN.pattern}$"
    return re.search(suffix, branch) is not None


def get_expected_files(branch: str) -> List[str]:
    """Return the expected source paths, relative to WORKFLOW_SOURCE_PATH, for a branch."""
    if branch == "qli-ci":
        return DEFAULT_BRANCH_FILES
    if is_ubuntu_packaging_branch(branch):
        return UBUNTU_PACKAGING_BRANCH_FILES
    return DEBIAN_PACKAGING_BRANCH_FILES


def get_obsolete_files(branch: str) -> List[str]:
    """Return the workflow filenames that must be absent from a branch."""
    if branch == "qli-ci":
        return DEFAULT_BRANCH_OBSOLETE_FILES
    if is_ubuntu_packaging_branch(branch):
        return UBUNTU_PACKAGING_BRANCH_OBSOLETE_FILES
    return DEBIAN_PACKAGING_BRANCH_OBSOLETE_FILES


def is_managed_branch(branch: str) -> bool:
    """Return True if branch is in the default managed set."""
    return (
        branch == "qli-ci"
        or branch in DEBIAN_PACKAGING_BRANCH_ALLOWLIST
        or UBUNTU_PACKAGING_BRANCH_PATTERN.fullmatch(branch) is not None
    )


def chore_branch_name(target_branch: str) -> str:
    """Return the chore branch name for a given target branch."""
    return f"chore/pkg-management-update/{target_branch}"


def find_differing_files(pkg_workdir: Path, source_dir: Path, files: List[str]) -> List[str]:
    """Return source paths of files that are missing or differ from source_dir."""
    differing = []
    for source_path in files:
        dest = pkg_workdir / ".github" / "workflows" / Path(source_path).name
        src = source_dir / source_path
        if not dest.exists() or dest.read_bytes() != src.read_bytes():
            differing.append(source_path)
    return differing


def find_obsolete_files(pkg_workdir: Path, obsolete: List[str]) -> List[str]:
    """Return filenames from obsolete that are present in .github/workflows/."""
    workflows_dir = pkg_workdir / ".github" / "workflows"
    return [filename for filename in obsolete if (workflows_dir / filename).exists()]


def remote_chore_branch_is_current(
    pkg_repo: pygit2.Repository,
    chore_branch: str,
    source_dir: Path,
    files: List[str],
    obsolete: List[str],
) -> bool:
    """Return True if the remote chore branch has correct content for all expected
    files and none of the obsolete files."""
    ref_name = f"refs/remotes/origin/{chore_branch}"
    try:
        ref = pkg_repo.lookup_reference(ref_name)
    except KeyError:
        return False
    tree = ref.peel(pygit2.Tree)
    try:
        github_entry = tree[".github"]
        workflows_tree = pkg_repo.get(pkg_repo.get(github_entry.id)["workflows"].id)
    except KeyError:
        return False
    for source_path in files:
        try:
            entry = workflows_tree[Path(source_path).name]
        except KeyError:
            return False
        blob = pkg_repo.get(entry.id)
        expected = (source_dir / source_path).read_bytes()
        if blob.data != expected:
            return False
    for filename in obsolete:
        if filename in workflows_tree:
            return False
    return True


def get_open_pr(
    gh_repo, head_branch: str, base_branch: str
) -> Optional[PullRequest]:
    """Return the open PR created by this script from head_branch to base_branch, or None."""
    owner = gh_repo.owner.login
    prs = gh_repo.get_pulls(
        state="open",
        head=f"{owner}:{head_branch}",
        base=base_branch,
    )
    for pr in prs:
        if pr.title == PR_TITLE and pr.body == PR_BODY:
            return pr
    return None


def checkout_remote_branch(pkg_repo: pygit2.Repository, branch: str) -> None:
    """Checkout a remote branch, creating a local tracking branch."""
    remote_ref = pkg_repo.lookup_reference(f"refs/remotes/origin/{branch}")
    # Create local branch tracking the remote if it doesn't exist
    local = pkg_repo.lookup_branch(branch, pygit2.GIT_BRANCH_LOCAL)
    if local is None:
        local = pkg_repo.create_branch(branch, remote_ref.peel(pygit2.Commit), False)
    pkg_repo.checkout(local)


def process_branch(
    target_branch: str,
    pkg_repo: pygit2.Repository,
    pkg_workdir: Path,
    source_dir: Path,
    gh_repo,
    callbacks: PushCallbacks,
    dry_run: bool,
    direct: bool = False,
) -> bool:
    """
    Process a single branch. Returns True if a change was needed or made.
    Raises SystemExit on unrecoverable error.
    """
    files = get_expected_files(target_branch)
    obsolete = get_obsolete_files(target_branch)

    checkout_remote_branch(pkg_repo, target_branch)

    differing = find_differing_files(pkg_workdir, source_dir, files)
    to_remove = find_obsolete_files(pkg_workdir, obsolete)

    if not differing and not to_remove:
        print(f"✓ {target_branch}: up to date")
        return False

    if dry_run:
        if differing:
            names = ", ".join(Path(p).name for p in differing)
            print(f"❌ {target_branch}: would update: {names}")
        if to_remove:
            print(f"❌ {target_branch}: would remove: {', '.join(to_remove)}")

    # Copy updated files into, and remove obsolete files from, the working tree
    workflows_dir = pkg_workdir / ".github" / "workflows"
    workflows_dir.mkdir(parents=True, exist_ok=True)
    for source_path in differing:
        shutil.copy2(source_dir / source_path, workflows_dir / Path(source_path).name)
    for filename in to_remove:
        (workflows_dir / filename).unlink()

    # Commit
    index = pkg_repo.index
    index.read()
    for source_path in differing:
        index.add(f".github/workflows/{Path(source_path).name}")
    for filename in to_remove:
        index.remove(f".github/workflows/{filename}")
    index.write()
    tree_oid = index.write_tree()
    sig = pygit2.Signature("qli-ci pkg-management", "noreply@github.com")
    pkg_repo.create_commit(
        "HEAD",
        sig,
        sig,
        "Update qli-ci workflow stubs",
        tree_oid,
        [pkg_repo.head.target],
    )

    if dry_run:
        return True

    if direct:
        remote = pkg_repo.remotes["origin"]
        push_or_raise(remote, f"HEAD:refs/heads/{target_branch}", callbacks)
        print(f"✓ {target_branch}: pushed directly")
        return True

    chore_branch = chore_branch_name(target_branch)

    # Check if remote chore branch is already current
    chore_is_current = remote_chore_branch_is_current(
        pkg_repo, chore_branch, source_dir, files, obsolete
    )
    open_pr = get_open_pr(gh_repo, chore_branch, target_branch)

    if chore_is_current and open_pr is not None:
        print(f"✓ {target_branch}: PR already up to date")
        return False

    if not chore_is_current:
        remote = pkg_repo.remotes["origin"]
        push_or_raise(remote, f"+HEAD:refs/heads/{chore_branch}", callbacks)
        print(f"✓ {target_branch}: pushed {chore_branch}")

    if open_pr is None:
        gh_repo.create_pull(
            title=PR_TITLE,
            body=PR_BODY,
            head=chore_branch,
            base=target_branch,
        )
        print(f"✓ {target_branch}: PR created")
    else:
        open_pr.create_issue_comment("Branch updated with latest qli-ci workflow stubs.")
        print(f"✓ {target_branch}: commented on existing PR #{open_pr.number}")

    return True


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Ensure workflow files in a pkg-* repository match the current state of "
                    "a configurable branch (default: main) of qualcomm-linux/qli-ci.",
    )
    mode_group = parser.add_mutually_exclusive_group()
    mode_group.add_argument(
        "--check",
        action="store_true",
        help="report what would change; commits are made locally but not pushed "
             "and no PRs are created/modified",
    )
    mode_group.add_argument(
        "--pr",
        action="store_true",
        help="push changes to a chore branch and file a pull request instead of pushing directly",
    )
    mode_group.add_argument(
        "--direct",
        action="store_true",
        help="(deprecated) push changes directly to the target branch; this is now the default",
    )
    parser.add_argument(
        "--no-clean",
        action="store_true",
        dest="no_clean",
        help="do not delete the temporary directory on exit; print its path for inspection",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="proceed even if the repository is not on the active-repo list",
    )
    parser.add_argument(
        "--debug-source-branch",
        default=WORKFLOW_SOURCE_DEFAULT_BRANCH,
        metavar="BRANCH",
        help="branch of qualcomm-linux/qli-ci to use as the source "
             f"(default: {WORKFLOW_SOURCE_DEFAULT_BRANCH!r})",
    )
    parser.add_argument(
        "repo_name",
        metavar="repo-name",
        help="repository name with pkg- prefix (e.g., 'pkg-fastrpc')",
    )
    parser.add_argument(
        "branches",
        nargs="*",
        metavar="branch",
        help="branches to process (default: qli-ci plus any packaging branches present in the repo)",
    )
    parsed = parser.parse_args()
    repo_name = parsed.repo_name
    dry_run = parsed.check
    if parsed.direct:
        print(
            "Warning: --direct is deprecated and will be removed in a future release. "
            "Direct push is now the default behaviour.",
            file=sys.stderr,
        )
    direct = not parsed.pr
    no_clean = parsed.no_clean
    source_branch = parsed.debug_source_branch
    explicit_branches = parsed.branches

    full_repo = expand_repo_name(repo_name)

    # Active-repo targeting guard: refuse to act on repositories that are not
    # on the live active-repo list, unless --force is given. Checked up front,
    # before cloning or the compliance gate.
    if not parsed.force:
        try:
            if not is_repo_active(repo_name):
                raise CLIError(active_repo_refusal_message(repo_name))
        except ActiveRepoListError as e:
            raise CLIError(str(e))

    token = get_token()

    # COMPLIANCE GATE: refuse to deploy or compare workflow files unless the
    # 'is-pkg-repo' compliance gate is satisfied. Enforced in all modes
    # (--check, --pr, direct) and deliberately not bypassable; see
    # SPECIFICATION.md.
    require_pkg_repo_compliance_gate(full_repo)

    callbacks = PushCallbacks(token)
    gh = github.Github(auth=github.Auth.Token(token))

    changes = False

    with tempfile.TemporaryDirectory(
        prefix=f"qli-ci-wf-{repo_name}-", delete=not no_clean
    ) as tmpdir:
        tmppath = Path(tmpdir)

        print("Cloning repositories...")
        try:
            pygit2.clone_repository(
                f"https://github.com/{WORKFLOW_SOURCE_REPO}.git",
                str(tmppath / "qli-ci"),
                checkout_branch=source_branch,
                callbacks=callbacks,
            )
        except pygit2.GitError as e:
            raise CLIError(f"failed to clone {WORKFLOW_SOURCE_REPO}: {e}")

        try:
            pkg_repo = pygit2.clone_repository(
                f"https://github.com/{full_repo}.git",
                str(tmppath / repo_name),
                callbacks=callbacks,
            )
        except pygit2.GitError as e:
            raise CLIError(f"failed to clone {full_repo}: {e}")

        source_dir = tmppath / "qli-ci" / WORKFLOW_SOURCE_PATH
        pkg_workdir = tmppath / repo_name
        if not source_dir.is_dir():
            raise CLIError(
                "workflow source directory "
                f"{WORKFLOW_SOURCE_PATH!r} not found in "
                f"{WORKFLOW_SOURCE_REPO}@{source_branch}"
            )
        all_source_files = sorted(
            set(DEFAULT_BRANCH_FILES)
            | set(DEBIAN_PACKAGING_BRANCH_FILES)
            | set(UBUNTU_PACKAGING_BRANCH_FILES)
        )
        missing = [f for f in all_source_files if not (source_dir / f).is_file()]
        if missing:
            raise CLIError(
                f"workflow source files not found in {WORKFLOW_SOURCE_PATH!r} of "
                f"{WORKFLOW_SOURCE_REPO}@{source_branch}: {', '.join(missing)}"
            )

        if source_branch != WORKFLOW_SOURCE_DEFAULT_BRANCH:
            # Importing the debug case inline here helps with validation. If
            # verifying correctness of the production flow, this allows one to
            # exclude this module from consideration.
            import debug_branch_mod
            debug_branch_mod.modify_workflow_files(source_dir, source_branch)

        gh_repo = gh.get_repo(full_repo)

        if explicit_branches:
            all_branches = explicit_branches
        else:
            # Verify qli-ci branch exists
            try:
                pkg_repo.lookup_reference("refs/remotes/origin/qli-ci")
            except KeyError:
                raise CLIError(f"branch 'qli-ci' does not exist in {full_repo}")

            packaging_branches = sorted(
                ref.removeprefix("refs/remotes/origin/")
                for ref in pkg_repo.references
                if ref.startswith("refs/remotes/origin/")
                and ref.removeprefix("refs/remotes/origin/") != "qli-ci"
                and is_managed_branch(ref.removeprefix("refs/remotes/origin/"))
            )
            all_branches = ["qli-ci"] + packaging_branches

        if source_branch != WORKFLOW_SOURCE_DEFAULT_BRANCH and repo_name.startswith("pkg-"):
            default_set = {
                ref.removeprefix("refs/remotes/origin/")
                for ref in pkg_repo.references
                if ref.startswith("refs/remotes/origin/")
                and is_managed_branch(ref.removeprefix("refs/remotes/origin/"))
            }
            overlap = sorted(set(all_branches) & default_set)
            if overlap:
                raise CLIError(
                    "--debug-source-branch cannot be used on a pkg- repository when any branch "
                    "to process is in the default managed set; conflicting branches: "
                    + ", ".join(overlap)
                )

        print(f"Processing branches: {', '.join(all_branches)}")
        print()

        for branch in all_branches:
            try:
                changed = process_branch(
                    branch,
                    pkg_repo,
                    pkg_workdir,
                    source_dir,
                    gh_repo,
                    callbacks,
                    dry_run,
                    direct,
                )
                if changed:
                    changes = True
            except pygit2.GitError as e:
                raise CLIError(f"error processing branch {branch}: {e}")
            except CLIError:
                raise
            except Exception as e:
                raise CLIError(f"error processing branch {branch}: {e}")

        if no_clean:
            print(f"\nTemporary directory: {tmpdir}")
            print(f"Please remove it when done: rm -rf {tmpdir}")

    if dry_run and changes:
        print("\nSummary: changes needed (run without --check to apply)")
        raise CLIError("changes needed", exit_code=1)


if __name__ == "__main__":
    try:
        main()
    except CLIError as e:
        if e.exit_code != 1:
            print(f"Error: {e}", file=sys.stderr)
        sys.exit(e.exit_code)
