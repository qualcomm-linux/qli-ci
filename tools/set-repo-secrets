#!/usr/bin/env python3
"""
Set secrets for a GitHub repository required by debusine-action workflows.

This tool prompts for secrets and sets them appropriately:
- DEBUSINE_USER: repository-level secret
- DEBUSINE_TOKEN: repository-level secret
- DEBUSINE_RELEASE_TOKEN: environment-level secret (Production environment)
- DEBUSINE_RELEASE_TOKEN: environment-level secret (Staging environment)

Usage:
    set-repo-secrets [--check] <repo-name>

Arguments:
    repo-name    Repository name with pkg- prefix (e.g., 'pkg-fastrpc' expands to 'qualcomm-linux/pkg-fastrpc')

Options:
    --check      Report whether each required secret is present and when it was
                 last updated, without setting anything. Secret values cannot be
                 read back, so this verifies presence only, not correctness.
"""

# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
# SPDX-License-Identifier: BSD-3-Clause-Clear

# This tool's effect on a repository must match what SPECIFICATION.md
# describes. Before changing which secrets this tool sets, update
# SPECIFICATION.md first, then bring this implementation into sync with it.

import argparse
import getpass
import json
import subprocess
import sys
from typing import Dict, List, Optional, Tuple


# Required secrets, shared by the set and check paths so they never drift on
# which secrets are required.
REPO_SECRETS: List[str] = ["DEBUSINE_USER", "DEBUSINE_TOKEN"]
ENV_SECRETS: List[Tuple[str, str]] = [
    ("DEBUSINE_RELEASE_TOKEN", "Production"),
    ("DEBUSINE_RELEASE_TOKEN", "Staging"),
]


def run_gh_command(args: List[str]) -> str:
    """Run a gh CLI command and return stdout. Raises CalledProcessError on failure."""
    result = subprocess.run(
        ["gh"] + args, capture_output=True, text=True, check=True
    )
    return result.stdout


def expand_repo_name(repo_name: str) -> str:
    """Expand repo name to full owner/repo format."""
    return f"qualcomm-linux/{repo_name}"


def check_gh_auth() -> bool:
    """Check if gh is authenticated."""
    try:
        run_gh_command(["auth", "status"])
        return True
    except subprocess.CalledProcessError:
        return False


def set_repo_secret(repo: str, secret_name: str, secret_value: str) -> None:
    """Set a repository-level secret."""
    # Use gh secret set with stdin
    subprocess.run(
        ["gh", "secret", "set", secret_name, "-R", repo],
        input=secret_value,
        text=True,
        capture_output=True,
        check=True,
    )


def set_environment_secret(
    repo: str, env_name: str, secret_name: str, secret_value: str
) -> None:
    """Set an environment-level secret."""
    # Use gh secret set with environment flag
    subprocess.run(
        ["gh", "secret", "set", secret_name, "-R", repo, "-e", env_name],
        input=secret_value,
        text=True,
        capture_output=True,
        check=True,
    )


def list_secrets(repo: str, env_name: Optional[str] = None) -> Optional[Dict[str, str]]:
    """
    Return {secret_name: updated_at} for repo- or environment-level secrets.

    Returns None if the secrets cannot be listed (e.g. the environment does not
    exist yet), so callers can distinguish "cannot list" from "listed, none
    present".
    """
    args = ["secret", "list", "-R", repo, "--json", "name,updatedAt"]
    if env_name:
        args += ["-e", env_name]
    try:
        data = json.loads(run_gh_command(args))
    except subprocess.CalledProcessError as e:
        if e.stderr:
            print(e.stderr.strip(), file=sys.stderr)
        return None
    return {item["name"]: item["updatedAt"] for item in data}


def prompt_for_secret(secret_name: str, env_name: str = None, default: str = None) -> str:
    """Prompt user for a secret value."""
    label = f"{secret_name} ({env_name} environment)" if env_name else secret_name
    if default:
        label = f"{label} [{default}]"
    while True:
        value = getpass.getpass(f"Enter value for {label}: ")
        if value:
            return value
        if default:
            return default
        print("Error: Secret value cannot be empty. Please try again.")


def set_secrets(repo: str) -> int:
    """
    Prompt for and set all required secrets.
    Returns 0 on success, 1 on failure.
    """
    print(f"Setting secrets for repository: {repo}")
    print()

    descriptions = {
        "DEBUSINE_USER": "Repository secret for Debusine user",
        "DEBUSINE_TOKEN": "Repository secret for Debusine API authentication",
        "DEBUSINE_RELEASE_TOKEN": "Environment secret for Debusine release operations",
    }
    secret_defaults = {
        "DEBUSINE_USER": "DebusineGitHubCI@qualcomm.com",
    }

    # Set repository-level secrets
    print("Repository-level secrets:")
    for secret_name in REPO_SECRETS:
        print(f"\n{descriptions[secret_name]}")
        secret_value = prompt_for_secret(secret_name, default=secret_defaults.get(secret_name))
        set_repo_secret(repo, secret_name, secret_value)
        print(f"✓ Set {secret_name}")

    # Set environment-level secrets
    print("\n\nEnvironment-level secrets:")
    for secret_name, env_name in ENV_SECRETS:
        print(f"\n{descriptions[secret_name]}")
        secret_value = prompt_for_secret(secret_name, env_name=env_name)
        set_environment_secret(repo, env_name, secret_name, secret_value)
        print(f"✓ Set {secret_name} in {env_name} environment")

    print("\n✓ All secrets have been set successfully")
    return 0


def check_secrets(repo: str) -> int:
    """
    Report whether each required secret is present and when it was last updated.

    Secret values cannot be read back via the GitHub API, so this verifies
    presence only, not that a secret holds the correct value. Returns 0 if all
    required secrets are present, 1 if any is missing.
    """
    print(f"Checking secrets for repository: {repo}")
    print()

    missing = False

    def report(present: bool, updated_at: Optional[str], label: str) -> None:
        nonlocal missing
        if present:
            print(f"✓ {label} present (last updated: {updated_at})")
        else:
            print(f"❌ {label} is missing")
            missing = True

    # Repository-level secrets
    print("Repository-level secrets:")
    repo_secrets = list_secrets(repo)
    if repo_secrets is None:
        print("❌ Unable to list repository secrets")
        missing = True
        repo_secrets = {}
    for secret_name in REPO_SECRETS:
        report(secret_name in repo_secrets, repo_secrets.get(secret_name), secret_name)

    # Environment-level secrets
    print("\nEnvironment-level secrets:")
    for secret_name, env_name in ENV_SECRETS:
        label = f"{secret_name} ({env_name} environment)"
        env_secrets = list_secrets(repo, env_name)
        if env_secrets is None:
            print(f"❌ Unable to list secrets for '{env_name}' environment (does it exist?)")
            missing = True
            continue
        report(secret_name in env_secrets, env_secrets.get(secret_name), label)

    print()
    print(
        "Note: secret values cannot be read back, so this confirms presence "
        "only, not that each value is correct."
    )
    if missing:
        print("\nSummary: One or more required secrets are missing")
        return 1
    print("\n✓ All required secrets are present")
    return 0


def main():
    """Main entry point."""
    parser = argparse.ArgumentParser(
        description="Set secrets for a GitHub repository required by "
        "debusine-action workflows.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "repo_name",
        metavar="repo-name",
        help="Repository name with pkg- prefix (e.g. 'pkg-fastrpc' expands to "
        "'qualcomm-linux/pkg-fastrpc')",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Report whether each required secret is present and when it was "
        "last updated, without setting anything. Secret values cannot be read "
        "back, so this verifies presence only, not correctness.",
    )
    args = parser.parse_args()

    # Check gh authentication
    if not check_gh_auth():
        print(
            "Error: gh is not authenticated. Run 'gh auth login' first.",
            file=sys.stderr,
        )
        return 1

    # Expand repo name
    full_repo = expand_repo_name(args.repo_name)

    # Check or set secrets
    return check_secrets(full_repo) if args.check else set_secrets(full_repo)


if __name__ == "__main__":
    sys.exit(main())
